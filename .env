# Database Configuration
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=hostname
DB_PORT=5432

# Django Secret Key
SECRET_KEY=your_generated_secret_key

# Debug Settings
DEBUG=True

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60  # minutes
JWT_REFRESH_TOKEN_LIFETIME=1  # days
